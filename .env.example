# Supabase project (Phase 3). Public anon key only — never put the service role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Lists the seeded demo logins on the login screen (seed data only, never in production).
VITE_SHOW_DEMO_LOGINS=
# Force the in-browser demo backend even when Supabase keys are set (used by screen tests).
VITE_BACKEND=
# Public site URL for canonical and social preview tags (no trailing slash).
VITE_SITE_URL=
# Push notifications in the apps (needs Firebase and APNs first).
VITE_PUSH_ENABLED=
# Stripe publishable key (pk_test_… or pk_live_…). Card payments are real only with it set;
# the secret key goes in Supabase Edge Function secrets, never here. See LAUNCH.md.
VITE_STRIPE_PUBLISHABLE_KEY=
